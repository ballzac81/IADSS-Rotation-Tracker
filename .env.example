# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Webhook authentication — generate with: openssl rand -hex 24
SECRET_TOKEN=

# Telegram notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# This stack's Freqtrade (rotation-freqtrade container). Do not point this
# at the live IADSS freqtrade container.
FREQTRADE_API=http://rotation-freqtrade:8080/api/v1
FREQTRADE_USER=admin
FREQTRADE_PASS=

# Pair rotation — Long sells QUOTE to buy BASE; Short sells BASE to buy QUOTE
ROTATE_BASE=HYPE
ROTATE_QUOTE=SOL
STAKE_CURRENCY=USD
ROTATE_RATIO=0.5
MIN_STAKE=10
FEE_BPS=0

# Seconds to wait for a market sell to credit free capital before the buy
SETTLE_TIMEOUT=60

# Unraid / docker-compose.selfhosted.yml — existing Cloudflare tunnel network
# so rotate.yourdomain.com can reach this stack. IADSS stays on its own Freqtrade.
DOCKER_NETWORK=

# BOOK_FILE=/data/rotation_book.json
