# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Webhook authentication — generate with: openssl rand -hex 24
SECRET_TOKEN=

# Telegram notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hyperliquid spot (dedicated subaccount, not PTOS, not Kraken) ---
# Agent / API wallet private key from https://app.hyperliquid.xyz/API
# Trading only — agent wallets cannot withdraw.
HL_AGENT_PRIVATE_KEY=

# Master wallet address (the one you connect in the HL UI), NOT the agent address
HL_ACCOUNT_ADDRESS=

# HYPE-SOL-rotate subaccount 0x… from https://app.hyperliquid.xyz/subAccounts
# Leave empty only if the master itself is the rotation wallet (not recommended).
HL_SUBACCOUNT_ADDRESS=

# mainnet or testnet
HL_NETWORK=mainnet

# Keep true until you have watched /preview and Telegram. Then false.
DRY_RUN=true

# Pair rotation — Long sells QUOTE to buy BASE; Short sells BASE to buy QUOTE
ROTATE_BASE=HYPE
ROTATE_QUOTE=SOL
STAKE_CURRENCY=USDC
ROTATE_RATIO=0.5
MIN_STAKE=10
FEE_BPS=0
SLIPPAGE=0.01

# If auto-detect fails (SOL is often USOL on HL spot):
# HL_SPOT_BASE=HYPE/USDC
# HL_SPOT_QUOTE=USOL/USDC

SETTLE_TIMEOUT=30

# Unraid / docker-compose.selfhosted.yml — existing Cloudflare tunnel network
DOCKER_NETWORK=
